{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.0.0/resources/zpack-schema.json",
  "name": "vivac",
  "version": "1.0.0",
  "description": "The vivac bar: ten workspaces, the gauges the machine can answer for, and the palette of the current theme.",
  "tags": ["topbar", "glazewm"],
  "previewImages": [],
  "repositoryUrl": "",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.js", "*.json"],
      "caching": {
        "defaultDuration": 604800,
        "rules": [
          { "urlRegex": "\\.(css|js|json)$", "duration": 0 }
        ]
      },
      "privileges": {
        "shellCommands": [
          { "program": "conhost.exe", "argsRegex": "^--headless powershell\\.exe -NoProfile -ExecutionPolicy Bypass -File C:\\\\Users\\\\alvar\\\\bin\\\\sesiones\\.ps1 (restaurar|guardar)$" },
          {
            "program": "cmd.exe",
            "argsRegex": "^/c echo (theme|power|help|sound|bluetooth|security|network|updates|phone)>\\\\\\\\\\.\\\\pipe\\\\vivac-[a-z0-9_.-]+ 2>nul \\|\\| conhost\\.exe --headless powershell\\.exe -NoProfile -ExecutionPolicy Bypass -File \\S+\\\\bin\\\\vivac\\.ps1 (theme|power|help|sound|bluetooth|security|network|updates|phone)$"
          },
          {
            "program": "cmd.exe",
            "argsRegex": "^/c echo (hover|hover-leave) (network|bluetooth|sound|security|theme|power|updates|usb:[A-Za-z]:)>\\\\\\\\\\.\\\\pipe\\\\vivac-[a-z0-9_.-]+ 2>nul$"
          },
          {
            "program": "powershell.exe",
            "argsRegex": "^-NoProfile -NonInteractive -ExecutionPolicy Bypass -File \\S+\\\\bin\\\\vivac-security\\.ps1 -Status$"
          },
          {
            "program": "powershell.exe",
            "argsRegex": "^-NoProfile -NonInteractive -ExecutionPolicy Bypass -File \\S+\\\\bin\\\\vivac-tray\\.ps1 (-Status|-Drives|-Updates|-Bluetooth|-Eject [A-Z]:|-Browse [A-Z]:|-DriveMenu [A-Z]:|-Open (bluetooth|updates|antivirus))$"
          },
          {
            "program": "powershell.exe",
            "argsRegex": "^-NoProfile -NonInteractive -ExecutionPolicy Bypass -File \\S+\\\\bin\\\\vivac-phone\\.ps1 -Status$"
          },
          {
            "program": "nvidia-smi",
            "argsRegex": "^--query-gpu=temperature\\.gpu,utilization\\.gpu --format=csv,noheader,nounits$"
          },
          {
            "program": "cmd.exe",
            "argsRegex": "^/d /c cd /d %LOCALAPPDATA%\\\\vivac && type nul>bar.alive$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "48px",
          "monitorSelection": { "type": "all" },
          "dockToEdge": { "enabled": true, "edge": "top", "windowMargin": "0px" }
        }
      ]
    },
    {
      "name": "calendar",
      "htmlPath": "./calendar.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.js", "*.json"],
      "caching": { "defaultDuration": 604800, "rules": [{ "urlRegex": "\\.(css|js|json)$", "duration": 0 }] },
      "privileges": { "shellCommands": [] },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "46px",
          "width": "468px",
          "height": "700px",
          "monitorSelection": { "type": "primary" }
        }
      ]
    },
    {
      "name": "forecast",
      "htmlPath": "./forecast.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.js", "*.json"],
      "caching": { "defaultDuration": 604800, "rules": [{ "urlRegex": "\\.(css|js|json)$", "duration": 0 }] },
      "privileges": { "shellCommands": [] },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "46px",
          "width": "580px",
          "height": "880px",
          "monitorSelection": { "type": "primary" }
        }
      ]
    },
    {
      "name": "system",
      "htmlPath": "./system.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.js", "*.json"],
      "caching": { "defaultDuration": 604800, "rules": [{ "urlRegex": "\\.(css|js|json)$", "duration": 0 }] },
      "privileges": { "shellCommands": [
          {
            "program": "powershell.exe",
            "argsRegex": "^-NoProfile -NonInteractive -ExecutionPolicy Bypass -File \\S+\\\\bin\\\\vivac-sysinfo\\.ps1 (-Top|-Gpu|-Info|-Cores|-GpuProcs)$"
          }
        ] },
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-14px",
          "offsetY": "46px",
          "width": "540px",
          "height": "830px",
          "monitorSelection": { "type": "primary" }
        }
      ]
    }
  ]
}
