* { border: none; border-radius: 0; font-family: "JetBrains Mono Nerd Font", "Font Awesome 6 Free"; font-size: 13px; min-height: 0; }
window#waybar { background: rgba(@COLOR_BG:rgb@, 0.95); border-radius: 12px; border-bottom: 3px solid #@COLOR_ACCENT@; color: #@COLOR_FG@; }
#custom-ws, #clock, #cpu, #memory, #disk, #network, #pulseaudio, #custom-updates, #custom-gpu, #bluetooth, #backlight, #battery, #temperature, #custom-weather, #window, #submap { background: rgba(@COLOR_SURFACE:rgb@, 0.7); padding: 0 12px; margin: 5px 2px; border-radius: 10px; border-bottom: 2px solid #@COLOR_MUTED@; }
#custom-ws { color: #@COLOR_FG@; padding: 0 10px; }
#custom-ws.urgent { border-bottom: 2px solid #@COLOR_URGENT@; }
#custom-updates { color: #@COLOR_MUTED@; }
#network { color: #@COLOR_INFO@; }
/* Two network gauges, one per adapter: a missing link recedes, a link with
   no address is the one worth a look, so it takes the accent. */
#network.disconnected, #network.disabled { color: #@COLOR_MUTED@; }
#network.linked { color: #@COLOR_ACCENT@; }
#temperature.critical { color: #@COLOR_URGENT@; border-bottom: 2px solid #@COLOR_URGENT@; }
#custom-weather { color: #@COLOR_FG_DIM@; }
/* The focused window's title is context, not a reading: it recedes, and it
   carries no border so it does not read as another gauge. */
#window { color: #@COLOR_FG_DIM@; border-bottom: none; background: transparent; }
#window.empty { color: #@COLOR_MUTED@; }
#submap { color: #@COLOR_BG@; background: #@COLOR_ACCENT@; }
#bluetooth.connected { color: #@COLOR_OK@; }
#custom-theme { background: rgba(@COLOR_SURFACE:rgb@, 0.7); color: #@COLOR_ACCENT@; border-radius: 10px; margin: 5px 2px; padding: 0 10px; }
#custom-power { background: #@COLOR_ACCENT@; color: #@COLOR_BG@; border-radius: 10px; margin: 5px; padding: 0 10px; }
tooltip { background: rgba(@COLOR_BG:rgb@, 0.98); border: 2px solid #@COLOR_ACCENT@; border-radius: 8px; }
tooltip label { color: #@COLOR_FG@; }
