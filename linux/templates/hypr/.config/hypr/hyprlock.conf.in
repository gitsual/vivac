# Hyprlang has no inline block: a block opened and closed on one line is
# parsed as nothing, and the settings inside it are dropped in silence. The
# lock screen spent its life drawing a black field instead of the palette,
# and showing the cursor it was asked to hide, because these two blocks were
# written that way. Keep every block open across lines.
# The common lock screen (Comun-Bloqueo): the wallpaper blurred and dimmed, a
# huge clock, the date, who you are and the password field. hyprlock has no
# avatar image of ours, so the avatar is a round shape carrying the user's
# initial; the keyboard and network pills of the Windows lock are not
# available (no widget reads them), so only the key hint is drawn.
general {
    hide_cursor = true
}
background {
    monitor =
    path = screenshot
    color = rgb(@COLOR_BG@)
    blur_passes = 3
    blur_size = 8
    brightness = 0.55
    vibrancy = 0.15
}
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgb(@COLOR_FG@)
    font_family = JetBrainsMono Nerd Font Propo ExtraBold
    font_size = 150
    position = 0, 190
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] date +"%A, %-d %B"
    color = rgb(@COLOR_FG_DIM@)
    font_family = JetBrainsMono Nerd Font Propo
    font_size = 20
    position = 0, 90
    halign = center
    valign = center
}
shape {
    monitor =
    size = 64, 64
    rounding = -1
    color = rgb(@COLOR_ACCENT@)
    position = 0, 10
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[] id -un | cut -c1 | tr a-z A-Z
    color = rgb(@COLOR_BG@)
    font_family = JetBrainsMono Nerd Font Propo ExtraBold
    font_size = 28
    position = 0, 10
    halign = center
    valign = center
}
label {
    monitor =
    text = $USER
    color = rgb(@COLOR_FG@)
    font_family = JetBrainsMono Nerd Font Propo ExtraBold
    font_size = 16
    position = 0, -40
    halign = center
    valign = center
}
input-field {
    monitor =
    size = 320, 44
    rounding = 12
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.35
    dots_rounding = -1
    outer_color = rgb(@COLOR_ACCENT@)
    inner_color = rgb(@COLOR_SURFACE@)
    font_color = rgb(@COLOR_FG@)
    check_color = rgb(@COLOR_INFO@)
    fail_color = rgb(@COLOR_URGENT@)
    fail_text = <i>$FAIL</i>
    fade_on_empty = false
    placeholder_text = <span foreground="##@COLOR_FG_DIM@">󰌾  password</span>
    position = 0, -95
    halign = center
    valign = center
}
label {
    monitor =
    text = ⏎ enter
    color = rgb(@COLOR_FG_DIM@)
    font_family = JetBrainsMono Nerd Font Propo
    font_size = 12
    position = 0, -150
    halign = center
    valign = center
}
