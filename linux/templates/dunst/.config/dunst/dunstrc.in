[global]
    # The common notification card (Comun-Notificacion): icon tile on the
    # left, "app" small and dim, the summary bold, the body dim, a thin
    # progress line along the bottom. dunst has no clock line and no
    # per-part colour except through markup, so the time is omitted and the
    # dim parts are spans. Top right, 15 px from both edges, where the owner keeps it.
    width = (340, 440)
    height = (96, 200)
    offset = (15, 15)
    origin = top-right
    transparency = 0
    corner_radius = 14
    frame_width = 2
    gap_size = 8
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    progress_bar_horizontal_alignment = left
    highlight = "#@COLOR_ACCENT@"
    format = "<span size='small' foreground='#@COLOR_FG_DIM@'>%a</span>\n<b>%s</b>\n<span foreground='#@COLOR_FG_DIM@'>%b</span>"
    show_indicators = false
    font = JetBrains Mono Nerd Font 10
    icon_theme = Papirus
    icon_position = left
    min_icon_size = 48
    max_icon_size = 48
    text_icon_padding = 12
    padding = 14
    horizontal_padding = 16
    vertical_alignment = center
    frame_color = "#@COLOR_ACCENT@"
    separator_color = "#@COLOR_MUTED@"
    background = "#@COLOR_BG@"
    foreground = "#@COLOR_FG@"
[urgency_low]
    frame_color = "#@COLOR_BORDER_INACTIVE@"
    timeout = 5
[urgency_normal]
    frame_color = "#@COLOR_ACCENT@"
    timeout = 10
# Critical changes colour and shape: the urgent frame, a warning glyph before
# the summary and a thicker frame, so it never relies on colour alone.
[urgency_critical]
    foreground = "#@COLOR_FG@"
    frame_color = "#@COLOR_URGENT@"
    highlight = "#@COLOR_URGENT@"
    format = "<span size='small' foreground='#@COLOR_URGENT@'>󰀦 %a</span>\n<b>%s</b>\n<span foreground='#@COLOR_FG_DIM@'>%b</span>"
    timeout = 0
# The phone's notifications, as KDE Connect passes them on (vivac-phone):
# the palette and timeouts above like any other, with a phone glyph before
# the summary so they read as the phone's and not this machine's. A pairing
# request comes the same way, with its Accept and Reject actions.
[vivac-phone]
    appname = "KDE Connect"
    format = "<span size='small' foreground='#@COLOR_FG_DIM@'>󰄜 %a</span>\n<b>%s</b>\n<span foreground='#@COLOR_FG_DIM@'>%b</span>"
