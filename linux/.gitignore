# Machine-specific generated state; hardware-facts.example is the committed one
hardware-facts
hardware-facts.override
# The fixture goldens are committed: a test compares against them.
!tests/golden/*/hardware-facts

# Local test and audit output
.audit/
.vm-test/
.vm-image/
# Built VM artifacts are published as release assets, never committed
dist/
*.local.txt
*.log

# Editor and OS state
.DS_Store
*.swp
*.swo
*~

# Never publish credentials or private key material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kdbx
**/.ssh/**
**/.gnupg/**
**/credentials*
**/tokens*
**/cookies*

# SDD session artifacts
.atl/
