{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 0,
  "margin-top": 6,
  "margin-left": 15,
  "margin-right": 15,
  "modules-left": ["group/workspaces", "hyprland/submap", "hyprland/window"],
  "modules-center": ["clock", "custom/weather"],
  "modules-right": [
@?has_wifi=yes@    "network#wireless",
    "network#wired",
    "custom/sep#9",
    "custom/phone",
    "custom/sep#1",
    "group/system",
    "custom/sep#2",
@?has_bluetooth=yes@    "bluetooth",
@?has_bluetooth=yes@    "custom/sep#3",
@?has_backlight=yes@    "backlight",
    "pulseaudio",
    "custom/usb",
    "custom/sep#4",
    "custom/security",
    "custom/sep#5",
@?setting_bar_owner_scripts=yes@    "custom/sessions",
@?setting_bar_owner_scripts=yes@    "custom/sep#6",
    "custom/theme",
    "custom/sep#7",
    "tray",
    "custom/updates",
    "custom/sep#8",
@?has_battery=yes@    "battery",
    "custom/power"
  ],
  "group/workspaces": {"orientation": "horizontal", "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"]},
  "custom/ws1": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 1", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 1", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 1", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws2": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 2", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 2", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 2", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws3": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 3", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 3", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 3", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws4": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 4", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 4", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 4", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws5": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 5", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 5", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 5", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws6": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 6", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 6", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 6", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws7": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 7", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 7", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 7", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws8": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 8", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 8", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 8", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws9": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 9", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 9", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 9", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws10": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 10", "return-type": "json", "signal": 1, "format": "{}", "on-click-right": "$HOME/.config/waybar/scripts/ws-windows.sh 10", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 10", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "hyprland/window": {"format": "{title}", "max-length": 60, "separate-outputs": true, "rewrite": {"": "󰇄 desktop"}},
  "hyprland/submap": {"format": "󰌌 {}", "tooltip": false},
  "clock": {"locale": "es_ES.UTF-8", "format": "󰥔 {:L%H:%M  %a %d %b %Y}", "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>", "on-click": "$HOME/.local/bin/vivac-panel calendar"},
  "cpu": {"format": "󰻠 {usage}%", "interval": 2, "on-click": "$HOME/.local/bin/vivac-panel system cpu"},
  "memory": {"format": "󰍛 {percentage}%", "interval": 5, "on-click": "$HOME/.local/bin/vivac-panel system memory"},
  "disk": {"format": "󰋊 {percentage_used}%", "path": "/", "interval": 30, "on-click": "$HOME/.local/bin/vivac-panel system disk"},
@?has_wifi=yes@  "network#wireless": {"interface": "@SETTING_BAR_WIFI_INTERFACE@", "format-wifi": "󰖩 {signalStrength}%", "format-linked": "󰖩 !", "format-disconnected": "󰖪", "format-disabled": "󰖪", "tooltip-format-wifi": "{essid} {signalStrength}%  {frequency} GHz\n{ifname}  {ipaddr}/{cidr}  gw {gwaddr}\nUp: {bandwidthUpBits}  Down: {bandwidthDownBits}", "tooltip-format-disconnected": "Wi-Fi: not connected", "tooltip-format-linked": "{essid}: connected, no IP", "on-click": "$HOME/.local/bin/vivac-panel network", "on-click-right": "nm-connection-editor", "on-click-middle": "$HOME/.config/waybar/scripts/net-wireless.sh", "interval": 5},
  "network#wired": {"interface": "e*", "format-ethernet": "󰈀", "format-linked": "󰈀 !", "format-disconnected": "󰈂", "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}  gw {gwaddr}\nUp: {bandwidthUpBits}  Down: {bandwidthDownBits}", "tooltip-format-disconnected": "Wired: no link", "tooltip-format-linked": "{ifname}: link, no IP", "on-click": "$HOME/.local/bin/vivac-panel network", "on-click-right": "nm-connection-editor", "on-click-middle": "$HOME/.config/waybar/scripts/net-wired.sh", "interval": 5},
@?has_bluetooth=yes@  "bluetooth": {"format": "{icon}", "format-icons": {"enabled": "󰂯", "disabled": "󰂲", "connected": "󰂱"}, "format-connected": "{icon} {num_connections}", "tooltip-format": "{status}", "tooltip-format-connected": "{device_enumerate}", "tooltip-format-enumerate-connected": "{device_alias}", "on-click": "$HOME/.local/bin/vivac-panel bluetooth"},
@?cpu_temp_path!=none@  "temperature": {"hwmon-path": "@FACT_CPU_TEMP_PATH@", "critical-threshold": 80, "format": "{icon} {temperatureC}°C", "format-icons": ["󱃃", "󰔏", "󱃂"], "tooltip-format": "CPU: {temperatureC}°C", "on-click": "$HOME/.local/bin/vivac-panel system cpu"},
@?gpu_vendors~nvidia@  "custom/gpu": {"exec-if": "command -v nvidia-smi", "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits", "format": "󰢮 {}°C", "interval": 5, "on-click": "$HOME/.local/bin/vivac-panel system gpu"},
@?has_backlight=yes@  "backlight": {"format": "{icon} {percent}%", "format-icons": ["󰃞", "󰃟", "󰃠"], "on-scroll-up": "brightnessctl set +5%", "on-scroll-down": "brightnessctl set 5%-"},
@?has_battery=yes@  "battery": {"format": "{icon} {capacity}%", "format-charging": "󰂄 {capacity}%", "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"], "states": {"warning": 30, "critical": 15}, "interval": 30},
  "pulseaudio": {"format": "{icon} {volume}%", "format-muted": "󰝟", "format-icons": {"default": ["󰕿", "󰖀", "󰕾"]}, "on-click": "$HOME/.local/bin/vivac-panel sound", "on-click-right": "pavucontrol"},
@?setting_weather_location=auto@  "custom/weather": {"exec": "$HOME/.local/bin/vivac-panel waybar forecast", "return-type": "json", "interval": 1200, "format": "{}", "on-click": "$HOME/.local/bin/vivac-panel forecast"},
@?setting_weather_location!=auto@  "custom/weather": {"exec": "$HOME/.local/bin/vivac-panel waybar forecast", "return-type": "json", "interval": 1200, "format": "{}", "on-click": "$HOME/.local/bin/vivac-panel forecast"},
@?setting_bar_owner_scripts=yes@  "custom/updates": {"exec": "$HOME/.local/bin/vivac-panel waybar updates", "return-type": "json", "format": "󰏔 {}", "interval": 3600, "signal": 8, "on-click": "$HOME/.local/bin/vivac-panel updates", "on-click-right": "kitty --class vivac-update -e $HOME/.config/waybar/scripts/update-system.sh"},
@?setting_bar_owner_scripts!=yes@  "custom/updates": {"exec": "$HOME/.local/bin/vivac-panel waybar updates", "return-type": "json", "format": "󰏔 {}", "interval": 3600, "signal": 8, "on-click": "$HOME/.local/bin/vivac-panel updates"},
  "custom/phone": {"exec": "$HOME/.local/bin/vivac-phone waybar", "return-type": "json", "format": "{}", "interval": 60, "on-click": "$HOME/.local/bin/vivac-phone menu"},
  "custom/sep#1": {"format": " ", "tooltip": false},
  "custom/sep#2": {"format": " ", "tooltip": false},
  "custom/sep#3": {"format": " ", "tooltip": false},
  "custom/sep#4": {"format": " ", "tooltip": false},
  "custom/sep#5": {"format": " ", "tooltip": false},
  "custom/sep#7": {"format": " ", "tooltip": false},
  "custom/sep#6": {"format": " ", "tooltip": false},
  "custom/usb": {"exec": "$HOME/.local/bin/vivac-panel waybar usb", "return-type": "json", "format": "{}", "interval": 5, "on-click": "$HOME/.local/bin/vivac-panel usb"},
  "custom/security": {"exec": "$HOME/.local/bin/vivac-panel waybar security", "return-type": "json", "format": "{}", "interval": 300, "on-click": "$HOME/.local/bin/vivac-panel security"},
@?setting_bar_owner_scripts=yes@  "custom/sessions": {"exec": "$HOME/bin/sesiones waybar", "return-type": "json", "format": "{}", "interval": 60, "signal": 9, "on-click": "$HOME/.config/waybar/scripts/sesiones-restaurar.sh", "on-click-right": "$HOME/.config/waybar/scripts/sesiones-guardar.sh"},
  "tray": {"icon-size": 16, "spacing": 8, "show-passive-items": true},
  "custom/sep#8": {"format": " ", "tooltip": false},
  "custom/sep#9": {"format": " ", "tooltip": false},
  "group/system": {"orientation": "inherit", "drawer": {"transition-duration": 250, "children-class": "sys-gauge", "click-to-reveal": true, "transition-left-to-right": true}, "modules": [
    "custom/system",
    "cpu",
    "memory",
@?cpu_temp_path!=none@    "temperature",
@?gpu_vendors~nvidia@    "custom/gpu",
    "disk"
  ]},
  "custom/system": {"exec": "$HOME/.local/bin/vivac-panel waybar system", "return-type": "json", "format": "{}", "interval": 5, "on-click-right": "$HOME/.local/bin/vivac-panel system"},
  "custom/theme": {"format": "◐", "on-click": "$HOME/.local/bin/vivac-panel theme", "tooltip": false},
  "custom/power": {"format": "⏻", "on-click": "$HOME/.local/bin/vivac-panel power", "tooltip": false}
}
