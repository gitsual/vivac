[global]
    width = (300, 420)
    height = 100
    offset = 15x15
    origin = top-right
    transparency = 10
    corner_radius = 10
    frame_width = 2
    gap_size = 5
    font = JetBrains Mono Nerd Font 10
    icon_theme = Papirus
    icon_position = left
    min_icon_size = 48
    max_icon_size = 48
    text_icon_padding = 12
    padding = 12
    horizontal_padding = 12
    vertical_alignment = center
    frame_color = "#E1777D"
    separator_color = "#979367"
    background = "#2D1F2D"
    foreground = "#E8D5AB"
[urgency_low]
    frame_color = "#979367"
    timeout = 5
[urgency_normal]
    frame_color = "#E1777D"
    timeout = 10
[urgency_critical]
    foreground = "#E1777D"
    frame_color = "#BD6161"
    timeout = 0
# The phone's notifications, as KDE Connect passes them on (vivac-phone):
# the palette and timeouts above like any other, with a phone glyph before
# the summary so they read as the phone's and not this machine's. A pairing
# request comes the same way, with its Accept and Reject actions.
[vivac-phone]
    appname = "KDE Connect"
    format = "󰄜 <b>%s</b>\n%b"
