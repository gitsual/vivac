#!/usr/bin/env bash
# The bridge menu: rofi, in the session's language, with what this machine does
# together with Windows (docs/bridge.md at the root of the product).
#
#   --print   list the menu's rows, one per line, and exit
#
# The drop tray in both directions, the clipboard to the paired machine, the
# shared mouse on or off, and Restart in Windows when the firmware has an entry
# for it. As in the power menu, the action is chosen by position and never by
# the label it printed.
set -Eeuo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="${VIVAC_REPO:-$(cd -- "$(dirname -- "$self")/../../../.." && pwd -P)}"
# shellcheck source=lib/kv.sh
source "$repo_root/lib/kv.sh"
# shellcheck source=lib/i18n.sh
source "$repo_root/lib/i18n.sh"

language="$(i18n_session_language)"
i18n_load "$language" "${I18N_DIR:-$repo_root/i18n}" 2>/dev/null ||
	i18n_load en "${I18N_DIR:-$repo_root/i18n}"

# Each command is a program beside this one and its arguments, split on spaces
# here and run with the directory prefixed, so a $HOME with a space survives.
bin="$(dirname -- "$self")"
keys=(drop.title drop.send link.send_clip)
commands=('vivac-drop --open-in' 'vivac-drop --open-out' 'vivac-link send-clip')
# The shared mouse, once lan-mouse is installed; the row says what it is now.
if "$bin/vivac-mouse" available 2>/dev/null; then
	if grep -qx 'enabled=yes' "${XDG_STATE_HOME:-$HOME/.local/state}/vivac/mouse.conf" 2>/dev/null; then
		keys+=(mouse.menu_on)
	else
		keys+=(mouse.menu_off)
	fi
	commands+=('vivac-mouse toggle')
fi
if "$bin/vivac-reboot-other" --available 2>/dev/null; then
	keys+=(power.reboot_windows)
	commands+=(vivac-reboot-other)
fi

menu() {
	local key
	for key in "${keys[@]}"; do printf '%s\n' "$(i18n_get "$key")"; done
}

if [[ "${1:-}" == --print ]]; then
	menu
	exit 0
fi

chosen="$(menu | rofi -dmenu -i -format i -p "$(i18n_get bridge.title)")" || exit 0
[[ "$chosen" =~ ^[0-9]+$ ]] || exit 0
((chosen < ${#commands[@]})) || exit 0
read -r -a words <<<"${commands[$chosen]}"
if [[ "${words[0]}" == vivac-link || "${words[0]}" == vivac-mouse ]]; then
	# What send-clip says goes on screen: a menu has no terminal to print it in.
	output="$("$bin/${words[0]}" "${words[@]:1}" 2>&1)" || true
	title=link.title
	[[ "${words[0]}" == vivac-mouse ]] && title=mouse.title
	command -v notify-send >/dev/null && notify-send --app-name=vivac -- "$(i18n_get "$title")" "$output"
	exit 0
fi
exec "$bin/${words[0]}" "${words[@]:1}"
