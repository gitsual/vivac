#!/usr/bin/env bash
# Bring a photo the phone took (vivac-mcp's `photo` tool) to this PC:
#
#   vivac-phone-pull NAME|PHONE-PATH
#
# Prints the local absolute path, ready for Hermes to send as MEDIA:<path>.
# Talks to the phone's vivac-gate, which only streams vivac photos, over the
# SSH host alias $VIVAC_PHONE_HOST (default "pixel", see android/README.md).
# The alias may live in ~/.config/vivac/ssh_config, which is passed with -F
# when it exists.
set -Eeuo pipefail

host="${VIVAC_PHONE_HOST:-pixel}"
name="$(basename -- "${1:?usage: vivac-phone-pull NAME|PHONE-PATH}")"
[[ "$name" =~ ^photo-[0-9]{8}-[0-9]{6}\.jpg$ ]] || {
	printf 'vivac-phone-pull: not a vivac photo name: %s\n' "$1" >&2
	exit 2
}

dirs="${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"
downloads=""
[[ -f "$dirs" ]] && downloads="$(sed -n 's/^XDG_DOWNLOAD_DIR="\(.*\)"$/\1/p' "$dirs")"
downloads="${downloads/#\$HOME/$HOME}"
[[ "$downloads" == /* ]] || downloads="$HOME/Downloads"
dest_dir="$downloads/vivac-link/phone"
mkdir -p -- "$dest_dir"

dest="$dest_dir/$name"
part="$dest.part"
trap 'rm -f -- "$part"' EXIT
ssh_args=()
ssh_config="${XDG_CONFIG_HOME:-$HOME/.config}/vivac/ssh_config"
[[ -f "$ssh_config" ]] && ssh_args=(-F "$ssh_config")
ssh "${ssh_args[@]}" -o BatchMode=yes "$host" "vivac-photo-get $name" >"$part"
[[ -s "$part" ]] || {
	printf 'vivac-phone-pull: the phone sent nothing for %s\n' "$name" >&2
	exit 1
}
mv -- "$part" "$dest"
printf '%s\n' "$dest"
