#!/usr/bin/env bash
# Hermes Agent, one home for both halves of the dual boot (docs/bridge.md at
# the root of the product, "Hermes across the dual boot").
#
#   --status          where this side's Hermes home is, and whether Windows shares it
#   --available       exit 0 when hermes is installed here (the bridge menu asks)
#   --share [FOLDER]  move the home onto the Windows partition and leave a link
#                     behind; FOLDER is Windows' Hermes home
#                     (<mount>/Users/<name>/.hermes), found alone when there is one
#   --unshare         bring the home back to this side (the Windows copy stays)
#   --dry-run         with --share or --unshare: say what would move, move nothing
#   --yes             skip the confirmation (the caller already asked)
#   (none)            open Hermes in a terminal
#
# The home (config.yaml, memories/, skills/, SOUL.md, state.db...) lives on the
# Windows partition: Windows uses it natively and this side reaches it through
# the mount (/mnt/win, or VIVAC_WINDOWS_MOUNT). What Hermes itself calls this
# machine's (the code checkout with its venv, the tool store, the language
# servers, the caches, the dependency environment under installs/<key>) stays
# per side, under ~/.local/share/hermes, and is bind-mounted over a real folder
# of the same name in the shared home, on this side only (systemd mount units).
# No link of this side's is left on the Windows partition: Windows can neither
# follow nor copy one (measured: mkdir raises FileExistsError, copytree fails),
# and it keeps its own cache/ at that very path. Never both at once: a dual
# boot cannot run both, and a Hermes inside WSL must not point here. The shared
# root is not an option: Windows reaches it over 9P, where SQLite cannot lock.
set -Eeuo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="${VIVAC_REPO:-$(cd -- "$(dirname -- "$self")/../../../.." && pwd -P)}"
# shellcheck source=lib/kv.sh
source "$repo_root/lib/kv.sh"
# shellcheck source=lib/i18n.sh
source "$repo_root/lib/i18n.sh"

language="$(i18n_session_language)"
i18n_load "$language" "${I18N_DIR:-$repo_root/i18n}" 2>/dev/null ||
	i18n_load en "${I18N_DIR:-$repo_root/i18n}"

home="${HERMES_HOME:-$HOME/.hermes}"
mount="${VIVAC_WINDOWS_MOUNT:-/mnt/win}"
store="${XDG_DATA_HOME:-$HOME/.local/share}/hermes"
marker_name=vivac-hermes.conf
# What stays on this side, each mounted over the shared home's folder: the code
# checkout (with its venv), the tool store, the language servers (an npm tree)
# and the caches (uv's entries are symlinks here and path files on Windows;
# neither side reads the other's, and Windows keeps its own cache/ there). The
# dependency environments live under installs/<key>, the key being the first 16
# hex digits of the SHA-256 of the checkout's resolved path: through the mount,
# <shared home>/hermes-agent, so that one folder of installs/ is mounted too.
per_side=(hermes-agent tools lsp cache)
machine_dir=installs
systemd_dir="${VIVAC_SYSTEMD_DIR:-/etc/systemd/system}"

action=open folder='' dry_run=false assume_yes=false
while (($#)); do
	case "$1" in
	--status | --available | --unshare) action="${1#--}" ;;
	--share)
		action=share
		if (($# > 1)) && [[ "$2" != --* ]]; then
			folder="$2"
			shift
		fi
		;;
	--dry-run) dry_run=true ;;
	--yes) assume_yes=true ;;
	-h | --help)
		sed -n '2,13p' "$self"
		exit 0
		;;
	*)
		printf 'Unknown option: %s\n' "$1" >&2
		exit 2
		;;
	esac
	shift
done

# say KEY ARGS... — a line for the person, in the session's language; {1}, {2}
# are filled from ARGS.
say() {
	local key="$1" text
	shift
	text="$(i18n_get "$key")"
	local i=1
	for arg in "$@"; do
		text="${text//\{$i\}/$arg}"
		((i++))
	done
	printf '%s\n' "$text"
}
# tell KEY ARGS... — the same, to the terminal, or on screen from a menu.
tell() {
	local text
	text="$(say "$@")"
	printf 'vivac-hermes: %s\n' "$text" >&2
	[[ -t 2 ]] && return 0
	command -v notify-send >/dev/null || return 0
	notify-send --app-name=vivac -- "$(i18n_get hermes.title)" "$text" || true
}
step() { # step KEY ARGS... — one line of the plan or of what was done
	printf '  %s\n' "$(say "$@")"
}

installed() { command -v hermes >/dev/null 2>&1; }

# marker_get KEY — one key of the shared marker file, empty when absent.
marker_get() {
	[[ -f "$1/$marker_name" ]] || return 0
	kv_get "$1/$marker_name" "$2" 2>/dev/null || true
}
# marker_set DIR KEY VALUE — set one key, keeping the other side's lines.
marker_set() {
	local file="$1/$marker_name" temporary
	temporary="$(mktemp -- "$1/.$marker_name.XXXXXX")"
	if [[ -f "$file" ]]; then
		grep -vE "^[[:space:]]*$2[[:space:]]*=" "$file" >"$temporary" || true
	fi
	printf '%s=%s\n' "$2" "$3" >>"$temporary"
	mv -f -- "$temporary" "$file"
}

# windows_homes — every <mount>/Users/<name>/.hermes, one per line.
windows_homes() {
	local candidate
	for candidate in "$mount"/Users/*/.hermes; do
		[[ -d "$candidate" ]] || continue
		case "${candidate%/.hermes}" in */Public | */Default | */Default\ User | */All\ Users) continue ;; esac
		printf '%s\n' "$candidate"
	done
}

# shared_target — where the link points, raw, when the home is a link.
shared_target() { readlink -- "$home"; }

# install_key SHARED — the name Hermes gives this side's dependency environment
# once the checkout is mounted at SHARED/hermes-agent (pm/environments.py).
install_key() {
	printf '%s/hermes-agent' "$(readlink -f -- "$1")" | sha256sum | cut -c1-16
}

status() {
	local target
	if [[ -L "$home" ]]; then
		target="$(shared_target)"
		if [[ -d "$target" ]]; then
			say hermes.status_shared "$home" "$target"
			local since
			since="$(marker_get "$target" windows_shared)"
			[[ -n "$since" ]] && say hermes.status_windows "$since"
		else
			say hermes.status_unreachable "$home" "$target"
		fi
	elif [[ -d "$home" ]]; then
		say hermes.status_local "$home"
	else
		say hermes.status_none "$home"
	fi
	installed || say hermes.not_installed
	return 0
}

# running — a Hermes process of this user (the gateway, a chat): the home must
# not move under it. The bracket keeps this script's own line out of the match.
running() { pgrep -u "$(id -u)" -f '[h]ermes-agent/' >/dev/null 2>&1; }

confirm() { # confirm KEY ARGS... — ask once, unless --yes
	$assume_yes && return 0
	local answer
	read -r -p "$(say "$@") [y/N] " answer || true
	[[ "$answer" =~ ^[yYsS] ]]
}

# A home joins a home file by file: a folder both sides have (memories/,
# skills/) is walked, a file only Windows has stays, a file both have is this
# side's, Windows' copy set aside under the backup at the same relative path.
# A SQLite database and its journal are one thing: when this side's database
# wins, Windows' journal (-wal, -shm, -journal) goes aside with Windows'
# database even where this side has none, or SQLite would replay it into the
# wrong file.
journal_suffixes=(-wal -shm -journal)
# stray_journals SRC DST NAME — Windows' journals of NAME that SRC lacks.
stray_journals() {
	local suffix
	[[ "$3" == *.db ]] || return 0
	for suffix in "${journal_suffixes[@]}"; do
		[[ -e "$1/$3$suffix" || -L "$1/$3$suffix" ]] && continue
		[[ -e "$2/$3$suffix" || -L "$2/$3$suffix" ]] && printf '%s\n' "$3$suffix"
	done
	return 0
}
# skipped NAME — a top-level entry that never joins the shared home as data.
skipped() { case " ${per_side[*]} $machine_dir " in *" $1 "*) return 0 ;; esac; return 1; }

# mount_unit WHERE — the systemd unit name for a mount on WHERE.
mount_unit() { systemd-escape --path --suffix=mount -- "$1"; }
# bind SRC WHERE — mount SRC over WHERE now and at every boot (root, through sudo).
bind() {
	local src="$1" where="$2" unit temporary
	unit="$(mount_unit "$where")"
	temporary="$(mktemp)"
	cat >"$temporary" <<UNIT
[Unit]
Description=Hermes ${where##*/}, this side's own over the shared home's (vivac-hermes)
RequiresMountsFor=$src

[Mount]
What=$src
Where=$where
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
UNIT
	sudo install -m 0644 -- "$temporary" "$systemd_dir/$unit" &&
		sudo systemctl daemon-reload &&
		sudo systemctl enable --now "$unit"
	local status=$?
	rm -f -- "$temporary"
	return "$status"
}
# unbind WHERE — stop that mount and forget it.
unbind() {
	local unit
	unit="$(mount_unit "$1")"
	[[ -e "$systemd_dir/$unit" ]] || return 0
	sudo systemctl disable --now "$unit" || true
	sudo rm -f -- "$systemd_dir/$unit"
	sudo systemctl daemon-reload || true
}

# refresh PYTHON — Hermes writes its checkout's path into its launchers and
# names the dependency environment after it: once the checkout is reached
# through another path, have Hermes rewrite both (best effort, never fatal).
refresh() {
	[[ -x "$1" ]] || return 0
	step hermes.refreshing
	"$1" -m hermes_cli.venv_sync --project-root "$home/hermes-agent" >/dev/null 2>&1 || tell hermes.refresh_failed
	# The gateway's service names the checkout too, and a gateway rewrites it from
	# its own path: written again from here, enabled only if it was.
	local unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/hermes-gateway.service" login=--no-start-on-login
	if [[ -f "$unit" ]]; then
		systemctl --user is-enabled --quiet hermes-gateway 2>/dev/null && login=--start-on-login
		"$1" -m hermes_cli.main gateway install --force --no-start-now "$login" </dev/null >/dev/null 2>&1 || tell hermes.refresh_failed
	fi
	return 0
}

# conflicts_of SRC DST — those relative paths, one per line.
conflicts_of() {
	local src="$1" dst="$2" rel="${3:-}" entry name
	for entry in "$src"/.[!.]* "$src"/*; do
		[[ -e "$entry" || -L "$entry" ]] || continue
		name="${entry##*/}"
		[[ -z "$rel" ]] && skipped "$name" && continue
		if [[ -e "$dst/$name" || -L "$dst/$name" ]]; then
			if [[ -d "$entry" && ! -L "$entry" && -d "$dst/$name" && ! -L "$dst/$name" ]]; then
				conflicts_of "$entry" "$dst/$name" "$rel$name/"
			else
				printf '%s\n' "$rel$name"
			fi
		fi
		while IFS= read -r name; do printf '%s\n' "$rel$name"; done < <(stray_journals "$src" "$dst" "${entry##*/}")
	done
}
# merge_into SRC DST BACKUP — copy SRC's tree into DST that way, without
# insisting on owners and modes NTFS has none of. SRC is left as it was.
merge_into() {
	local src="$1" dst="$2" backup="$3" rel="${4:-}" entry name
	for entry in "$src"/.[!.]* "$src"/*; do
		[[ -e "$entry" || -L "$entry" ]] || continue
		name="${entry##*/}"
		[[ -z "$rel" ]] && skipped "$name" && continue
		if [[ -d "$entry" && ! -L "$entry" && -d "$dst/$name" && ! -L "$dst/$name" ]]; then
			merge_into "$entry" "$dst/$name" "$backup" "$rel$name/"
			continue
		fi
		if [[ -e "$dst/$name" || -L "$dst/$name" ]]; then
			mkdir -p -- "$backup/$rel"
			mv -- "$dst/$name" "$backup/$rel$name"
		fi
		local journal
		while IFS= read -r journal; do
			mkdir -p -- "$backup/$rel"
			mv -- "$dst/$journal" "$backup/$rel$journal"
		done < <(stray_journals "$src" "$dst" "$name")
		cp -r --preserve=timestamps -- "$entry" "$dst/$name"
	done
}

share() {
	local shared="$folder" stamp backup='' name entry key
	if [[ -L "$home" ]]; then
		tell hermes.already_shared "$home" "$(shared_target)"
		return 0
	fi
	if [[ -z "$shared" ]]; then
		local -a found=()
		mapfile -t found < <(windows_homes)
		if ((${#found[@]} == 0)); then
			tell hermes.no_windows "$mount/Users/*/.hermes"
			return 1
		elif ((${#found[@]} > 1)); then
			tell hermes.many_windows "$mount/Users"
			return 1
		fi
		shared="${found[0]}"
	fi
	[[ -d "$shared" ]] || {
		tell hermes.no_windows "$shared"
		return 1
	}
	[[ -d "$home" ]] || {
		tell hermes.status_none "$home"
		return 1
	}
	if running; then
		tell hermes.running
		return 1
	fi
	stamp="$(date +%Y%m%d-%H%M%S)"
	backup="$(dirname -- "$shared")/.hermes.windows-before-share-$stamp"
	key="$(install_key "$shared")"

	# The plan: per-side folders to the store, each mounted over the shared
	# home's; everything else into the shared home, a conflicting Windows file
	# aside first; then the link.
	say hermes.plan "$home" "$shared"
	for name in "${per_side[@]}" "$machine_dir"; do
		if [[ -e "$home/$name" && -e "$store/$name" ]]; then
			tell hermes.store_taken "$store/$name"
			return 1
		fi
		[[ -e "$home/$name" ]] && step hermes.would_move "$home/$name" "$store/$name"
	done
	for name in "${per_side[@]}" "$machine_dir/$key"; do
		step hermes.would_mount "$store/$name" "$shared/$name"
	done
	local -a conflicts=() entries=()
	for entry in "$home"/.[!.]* "$home"/*; do
		[[ -e "$entry" || -L "$entry" ]] || continue
		name="${entry##*/}"
		skipped "$name" && continue
		entries+=("$name")
	done
	mapfile -t conflicts < <(conflicts_of "$home" "$shared")
	((${#conflicts[@]})) && step hermes.would_backup "${conflicts[*]}" "$backup"
	step hermes.would_move "${entries[*]:-}" "$shared"
	step hermes.would_link "$home" "$shared"
	if $dry_run; then
		say hermes.dry_run
		return 0
	fi
	confirm hermes.confirm_share || return 0

	# The mounts first: should sudo or systemd refuse one, every mount made so
	# far is undone, this side's folders go back, and nothing else has changed.
	local -a made=() created=()
	local failed=''
	mkdir -p -- "$store"
	[[ -d "$home/$machine_dir" ]] && mv -- "$home/$machine_dir" "$store/$machine_dir"
	for name in "${per_side[@]}" "$machine_dir/$key"; do
		[[ -e "$shared/$name" ]] || created+=("$name")
		mkdir -p -- "$shared/$name"
		if [[ -e "$home/$name" ]]; then mv -- "$home/$name" "$store/$name"; else mkdir -p -- "$store/$name"; fi
		made+=("$name")
		if ! bind "$(readlink -f -- "$store/$name")" "$shared/$name"; then
			failed="$name"
			break
		fi
		step hermes.mounted "$store/$name" "$shared/$name"
	done
	if [[ -n "$failed" ]]; then
		for name in "${made[@]}"; do
			unbind "${shared:?}/${name:?}"
			[[ "$name" == "$machine_dir/"* ]] || mv -- "$store/$name" "$home/$name"
		done
		[[ -d "$store/$machine_dir" ]] && mv -- "$store/$machine_dir" "$home/$machine_dir"
		for name in "${created[@]}"; do rmdir -- "${shared:?}/${name:?}" 2>/dev/null || true; done
		rmdir -- "${shared:?}/${machine_dir:?}" 2>/dev/null || true
		tell hermes.mount_failed "$shared/$failed"
		return 1
	fi

	# Copies first, the originals only once every copy is in: a failure leaves
	# this side's home whole.
	merge_into "$home" "$shared" "$backup"
	[[ -d "$backup" ]] && step hermes.backup "$backup"
	for name in "${entries[@]}"; do rm -rf -- "${home:?}/${name:?}"; done
	rmdir -- "$home"
	ln -s -- "$shared" "$home"
	marker_set "$shared" linux_home "$home"
	marker_set "$shared" linux_store "$store"
	marker_set "$shared" linux_key "$key"
	marker_set "$shared" linux_created "${created[*]}"
	marker_set "$shared" linux_shared "$stamp"
	[[ -n "$backup" && -d "$backup" ]] && marker_set "$shared" windows_backup "$backup"
	refresh "$store/hermes-agent/venv/bin/python"
	tell hermes.shared_done "$home" "$shared"
}

unshare() {
	local shared fresh name entry key created
	[[ -L "$home" ]] || {
		tell hermes.not_shared "$home"
		return 1
	}
	shared="$(shared_target)"
	[[ -d "$shared" ]] || {
		tell hermes.status_unreachable "$home" "$shared"
		return 1
	}
	if running; then
		tell hermes.running
		return 1
	fi
	key="$(marker_get "$shared" linux_key)"
	created="$(marker_get "$shared" linux_created)"
	local -a mounts=("${per_side[@]}")
	[[ -n "$key" ]] && mounts+=("$machine_dir/$key")
	say hermes.plan_back "$shared" "$home"
	for name in "${mounts[@]}"; do
		[[ -e "$systemd_dir/$(mount_unit "$shared/$name")" ]] && step hermes.would_unmount "$shared/$name"
	done
	for name in "${per_side[@]}" "$machine_dir"; do
		[[ -d "$store/$name" ]] && step hermes.would_move "$store/$name" "$home/$name"
	done
	step hermes.would_copy "$shared" "$home"
	if $dry_run; then
		say hermes.dry_run
		return 0
	fi
	confirm hermes.confirm_unshare || return 0
	fresh="$(mktemp -d -- "$(dirname -- "$home")/.hermes.back.XXXXXX")"
	# Unmounted first, so what is copied below is Windows' own and this side's
	# comes back from the store.
	for name in "${mounts[@]}"; do unbind "$shared/$name"; done
	for entry in "$shared"/.[!.]* "$shared"/*; do
		[[ -e "$entry" || -L "$entry" ]] || continue
		name="${entry##*/}"
		# The marker stays Windows', and so do the per-side folders under the
		# mounts: this side's own come back from the store below.
		[[ "$name" == "$marker_name" ]] && continue
		skipped "$name" && continue
		if [[ "$name" == bin ]]; then
			# Windows' launchers stay Windows'; this side's tools come back.
			local tool
			for tool in "$entry"/*; do
				[[ -e "$tool" && "$tool" != *.exe ]] || continue
				mkdir -p -- "$fresh/bin"
				cp -r --preserve=timestamps -- "$tool" "$fresh/bin/"
			done
			continue
		fi
		cp -r --preserve=timestamps -- "$entry" "$fresh/$name"
	done
	for name in "${per_side[@]}" "$machine_dir"; do
		[[ -d "$store/$name" ]] || continue
		mv -- "$store/$name" "$fresh/$name"
		step hermes.moved "$store/$name" "$home/$name"
	done
	# The empty folders made for the mounts go; Windows' own stay.
	for name in $created; do rmdir -- "${shared:?}/${name:?}" 2>/dev/null || true; done
	rm -f -- "$home"
	mv -- "$fresh" "$home"
	marker_set "$shared" linux_shared none
	refresh "$home/hermes-agent/venv/bin/python"
	tell hermes.unshared_done "$home" "$shared"
}

open_hermes() {
	installed || {
		tell hermes.not_installed
		return 1
	}
	exec "${TERMINAL:-kitty}" -e hermes
}

case "$action" in
status) status ;;
available) installed ;;
share) share ;;
unshare) unshare ;;
open) open_hermes ;;
esac
