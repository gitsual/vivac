#!/usr/bin/env bash
# The phone's desktops on this computer (docs/bridge.md, "The phone").
#
#   vivac-phone-desk toggle
#                         the phone as ten more desktops, on or off. On: the
#                         phone's desktop 1 opens on workspace 11 and the view
#                         goes there; every other one, 2 to 10, opens by
#                         itself the first time workspace 12 to 20 is visited,
#                         and stays. Off (or the phone unplugged): every
#                         phone desktop closes and its apps go back to the
#                         phone's own screen.
#   vivac-phone-desk N    N from 1 to 10: the phone's desktop N, a virtual
#                         display of its own (Android's desktop mode: taskbar,
#                         launcher, free windows) shown by scrcpy in a window
#                         titled vivac-movil-N, which Hyprland puts on
#                         workspace 10+N; the view moves there. A desktop
#                         already open is only switched to.
#
# The phone is reached over adb (USB, or adb over Wi-Fi once paired); the
# first device adb lists, or VIVAC_PHONE_SERIAL. Closing the window gives its
# apps back to the phone's own screen instead of closing them.
set -Eeuo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="${VIVAC_REPO:-$(cd -- "$(dirname -- "$self")/../../../.." && pwd -P)}"
# shellcheck source=lib/kv.sh
source "$repo_root/lib/kv.sh"
# shellcheck source=lib/i18n.sh
source "$repo_root/lib/i18n.sh"
language="$(i18n_session_language)"
i18n_load "$language" "${I18N_DIR:-$repo_root/i18n}" 2>/dev/null ||
	i18n_load en "${I18N_DIR:-$repo_root/i18n}"

dispatch="${VIVAC_DISPATCH:-$HOME/.config/hypr/scripts/dispatch.sh}"
size="${VIVAC_PHONE_DESK_SIZE:-1920x1032/160}"
# scrcpy and this script find adb the same way: $ADB, the PATH, the SDK.
if [[ -z "${ADB:-}" ]]; then
	if command -v adb >/dev/null; then ADB=adb; else ADB="$HOME/Android/Sdk/platform-tools/adb"; fi
fi
export ADB

tell() {
	printf 'vivac-phone-desk: %s\n' "$1" >&2
	[[ -t 2 ]] && return 0
	command -v notify-send >/dev/null || return 0
	notify-send --app-name=vivac -- "$(i18n_get phone.title)" "$1" || true
}

state="${XDG_RUNTIME_DIR:-/tmp}/vivac-phone-desk.pid"
socket="${XDG_RUNTIME_DIR:-/tmp}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"

# phone — the adb serial of the phone, or nothing.
phone() {
	local serial="${VIVAC_PHONE_SERIAL:-}"
	if [[ -z "$serial" ]]; then
		serial="$("$ADB" devices 2>/dev/null | awk 'NR > 1 && $2 == "device" { print $1; exit }')" || serial=""
	fi
	[[ "$serial" =~ ^[A-Za-z0-9._:-]+$ ]] && printf '%s\n' "$serial"
}
is_open() { hyprctl clients -j 2>/dev/null | grep -q "\"title\": *\"vivac-movil-$1\""; }

# open N [go] — the phone's desktop N; with go, the view moves to it.
open_desk() {
	local n="$1" go="${2:-}" serial log
	if is_open "$n"; then
		[[ -n "$go" ]] && "$dispatch" workspace $((10 + n))
		return 0
	fi
	serial="$(phone)" || serial=""
	[[ -n "$serial" ]] || {
		tell "$(i18n_get phone.desk_none)"
		return 1
	}
	log="${XDG_STATE_HOME:-$HOME/.local/state}/vivac/phone-desk-$n.log"
	mkdir -p "$(dirname "$log")"
	setsid -f scrcpy -s "$serial" --new-display="$size" --window-title="vivac-movil-$n" \
		--no-audio --no-vd-destroy-content >"$log" 2>&1 </dev/null
	[[ -n "$go" ]] && "$dispatch" workspace $((10 + n))
	return 0
}

# follow — Hyprland's events on stdin: arriving at workspace 11-20 opens that
# phone desktop when it is not open yet. Every few quiet seconds the phone is
# looked for; once it is gone, everything closes.
follow() {
	local line ws
	while :; do
		if IFS= read -r -t "${VIVAC_PHONE_DESK_CHECK:-5}" line; then
			[[ "$line" =~ ^workspace\>\>([0-9]+)$ ]] || continue
			ws="${BASH_REMATCH[1]}"
			((ws >= 11 && ws <= 20)) && { open_desk $((ws - 10)) || true; }
		else
			(($? > 128)) || return 0
			[[ -n "$(phone)" ]] || {
				all_off
				return 0
			}
		fi
	done
}

all_off() {
	pkill -f -- '^scrcpy .*--window-title=vivac-movil-' 2>/dev/null || true
	rm -f -- "$state"
}
mode_on() { [[ -f "$state" ]] && kill -0 "$(cat "$state")" 2>/dev/null; }

case "${1:-}" in
toggle)
	if mode_on; then
		kill "$(cat "$state")" 2>/dev/null || true
		all_off
		tell "$(i18n_get phone.desk_off)"
		exit 0
	fi
	[[ -n "$(phone)" ]] || {
		tell "$(i18n_get phone.desk_none)"
		exit 1
	}
	setsid -f "$self" watch </dev/null >/dev/null 2>&1
	open_desk 1 go
	tell "$(i18n_get phone.desk_on)"
	exit 0
	;;
watch)
	printf '%s\n' "$$" >"$state"
	trap 'rm -f -- "$state"' EXIT
	socat -U - "UNIX-CONNECT:$socket" 2>/dev/null | follow
	exit 0
	;;
follow)
	follow
	exit 0
	;;
esac

n="${1:-}"
[[ "$n" =~ ^([1-9]|10)$ ]] || {
	printf 'usage: vivac-phone-desk toggle | N   (N from 1 to 10)\n' >&2
	exit 2
}
open_desk "$n" go
