[Desktop Entry]
Type=Application
Name=Phone as desktops
Name[es]=Móvil como escritorios
Comment=The phone on workspaces 11 to 20, with this computer's keyboard and mouse; open again to turn it off
Comment[es]=El móvil en los escritorios 11 a 20, con el teclado y el ratón de este equipo; ábrelo otra vez para apagarlo
Exec=sh -c "\\$HOME/.local/bin/vivac-phone-desk toggle"
Icon=smartphone
Terminal=false
Categories=Utility;
Keywords=phone;android;scrcpy;desktop;móvil;escritorio;
