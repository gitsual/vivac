#!/usr/bin/env python3
"""Run one local workstation task from a non-secret JSON description."""

from __future__ import annotations

import json
import os
import re
import shutil
import sys
from pathlib import Path

NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")


def fail(message: str) -> "NoReturn":
    print(f"workstation-task-runner: {message}", file=sys.stderr)
    raise SystemExit(2)


def main() -> None:
    if len(sys.argv) != 2 or not NAME.fullmatch(sys.argv[1]):
        fail("expected one safe task name")

    path = Path.home() / ".config" / "workstation" / "tasks" / f"{sys.argv[1]}.json"
    try:
        config = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read valid task configuration: {error}")

    command = config.get("command")
    if not isinstance(command, list) or not command or not all(
        isinstance(item, str) and item for item in command
    ):
        fail("command must be a non-empty JSON array of strings")

    environment = config.get("environment", {})
    if not isinstance(environment, dict) or not all(
        isinstance(key, str) and isinstance(value, str)
        for key, value in environment.items()
    ):
        fail("environment must map strings to strings")

    working_directory = Path(config.get("working_directory", str(Path.home()))).expanduser()
    if not working_directory.is_dir():
        fail("working_directory does not exist")

    executable = command[0]
    resolved = executable if os.path.isabs(executable) else shutil.which(executable)
    if not resolved:
        fail(f"executable not found: {executable}")

    os.chdir(working_directory)
    os.execvpe(resolved, command, os.environ | environment)


if __name__ == "__main__":
    main()
