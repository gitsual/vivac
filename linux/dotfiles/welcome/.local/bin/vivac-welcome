#!/usr/bin/env bash
set -Eeuo pipefail

# The first thing a stranger sees after logging in: three questions and a
# guided tour, in the palette, in their own language.
#
# It is deliberately a terminal program rather than a toolkit dialog. The
# desktop it is introducing is a tiling compositor driven from the keyboard,
# and a wizard that hands you a mouse teaches the wrong lesson on the first
# screen. What it does borrow from a graphical wizard is the manners: one
# question at a time, every choice reversible, the current answer always
# visible, and nothing applied that cannot be seen immediately.
#
#   --first-run   do nothing at all when the tour has already been taken
#
# Rerun it whenever you like: `vivac-welcome` with no arguments starts
# from the top and changes only what you confirm.

repo="${VIVAC_REPO:-$HOME/vivac}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/vivac"
marker="$state_dir/welcome-done"
settings_file="${XDG_CONFIG_HOME:-$HOME/.config}/vivac/settings"
preview_log="$state_dir/theme-preview.log"
locale_log="$state_dir/locale.log"
preview_note=''

if [[ "${1:-}" == --first-run ]]; then
	[[ -e "$marker" ]] && exit 0
fi
[[ -d "$repo" ]] || {
	printf 'The portfolio checkout is not at %s; set VIVAC_REPO.\n' "$repo" >&2
	exit 1
}

# ------------------------------------------------------------------ language

# Every line the wizard says comes from the same tables the help panes and the
# power menu read. It used to hold its own Spanish, so a session set to English
# got a Spanish tour -- the one program a stranger meets first, in a language
# they may not have.
# shellcheck source=lib/kv.sh
source "$repo/lib/kv.sh"
# shellcheck source=lib/i18n.sh
source "$repo/lib/i18n.sh"
# shellcheck source=lib/settings.sh
source "$repo/lib/settings.sh"
language="$(i18n_session_language "$settings_file")"
i18n_load "$language" "${I18N_DIR:-$repo/i18n}" 2>/dev/null ||
	i18n_load en "${I18N_DIR:-$repo/i18n}"

# t KEY [ARG...] — the text, with {1}, {2} ... filled in. An unknown key is
# not fatal: i18n_get prints the key in brackets, which is a louder trace on
# screen than an aborted wizard would be, and the gate below never lets one
# reach a release.
t() { i18n_format "$@" || true; }

# ---------------------------------------------------------------- appearance

# The wizard wears the theme it is offering, so a colour that is unreadable is
# unreadable here first. Truecolor escapes, because the palette is hex and the
# 256-colour cube would round it into something else.
declare -A palette=()
palette_load() {
	local name="$1" file key value
	if [[ "$name" == bad-romance ]]; then file="$repo/data/theme.conf"; else file="$repo/data/themes/$name.conf"; fi
	[[ -f "$file" ]] || return 1
	palette=()
	while IFS='=' read -r key value; do
		[[ "$key" == [A-Z]* ]] || continue
		palette["$key"]="$value"
	done <"$file"
	palette[TITLE]="$(sed -nE 's/^# @title: (.*)$/\1/p' "$file")"
	palette[ESSENCE]="$(sed -nE 's/^# @essence: (.*)$/\1/p' "$file")"
}

fg() { printf '\033[38;2;%d;%d;%dm' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
bg() { printf '\033[48;2;%d;%d;%dm' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
reset() { printf '\033[0m'; }

columns() { tput cols 2>/dev/null || printf '80'; }

# centre TEXT — pad to the middle of the terminal. Printable width, not byte
# length: the labels carry accents and box characters.
centre() {
	local text="$1" width visible pad
	width="$(columns)"
	visible="$(printf '%s' "$text" | sed -E 's/\x1b\[[0-9;]*m//g' | wc -L)"
	pad=$(((width - visible) / 2))
	((pad < 0)) && pad=0
	printf '%*s%s\n' "$pad" '' "$text"
}

frame() {
	local title="$1" subtitle="$2"
	printf '\033[2J\033[H'
	bg "${palette[COLOR_BG]}"
	printf '\033[2J\033[H'
	printf '\n\n'
	fg "${palette[COLOR_ACCENT]}"
	centre "$title"
	fg "${palette[COLOR_FG_DIM]}"
	centre "$subtitle"
	fg "${palette[COLOR_MUTED]}"
	centre "$(printf '─%.0s' {1..48})"
	printf '\n'
}

footer() {
	local hint="$1"
	printf '\n'
	if [[ -n "$preview_note" ]]; then
		fg "${palette[COLOR_URGENT]:-${palette[COLOR_ACCENT]}}"
		centre "$preview_note"
	fi
	fg "${palette[COLOR_MUTED]}"
	centre "$hint"
	reset
}

# choose TITLE SUBTITLE HINT PREVIEW_FN NAME... — a keyboard list. Prints the
# chosen name on stdout; everything it draws goes to the terminal directly, so
# the caller can capture the answer without capturing the interface.
choose() {
	local title="$1" subtitle="$2" hint="$3" preview="$4"
	shift 4
	local items=("$@") index=0 key last=-1 status
	# Dressing the whole desktop takes the better part of a second, so it can
	# not happen once per keypress: holding an arrow down queues one full
	# theme application per repeat and the list stops answering for as long as
	# the queue lasts. The preview waits for the selection to stand still, and
	# the list itself is redrawn immediately on every key.
	local settle=0.25
	while true; do
		{
			frame "$title" "$subtitle"
			local position label
			for position in "${!items[@]}"; do
				label="${labels[${items[$position]}]:-${items[$position]}}"
				if ((position == index)); then
					fg "${palette[COLOR_BG]}"
					bg "${palette[COLOR_ACCENT]}"
					centre "  ▸ $label  "
					bg "${palette[COLOR_BG]}"
				else
					fg "${palette[COLOR_FG]}"
					centre "    $label  "
				fi
			done
			footer "$hint"
		} >/dev/tty
		if ((index != last)) && [[ -n "$preview" ]]; then
			status=0
			IFS= read -rsn1 -t "$settle" key </dev/tty || status=$?
			if ((status > 128)); then
				# Nothing was typed while the selection stood still: this is
				# the one the eye landed on, so show it.
				"$preview" "${items[$index]}" || true
				last=$index
				continue
			fi
			((status == 0)) || break
		else
			IFS= read -rsn1 key </dev/tty
		fi
		case "$key" in
		$'\x1b')
			# An arrow key arrives as three bytes; a lone Escape as one.
			IFS= read -rsn2 -t 0.05 key </dev/tty || key=''
			case "$key" in
			'[A') ((index > 0)) && ((index--)) ;;
			'[B') ((index < ${#items[@]} - 1)) && ((index++)) ;;
			esac
			;;
		k) ((index > 0)) && ((index--)) ;;
		j) ((index < ${#items[@]} - 1)) && ((index++)) ;;
		'') break ;;
		esac
	done
	printf '%s' "${items[$index]}"
}

# ------------------------------------------------------------------ settings

# Answers go through lib/settings.sh, the same writer the theme picker uses, so
# the shared keys (language, theme) reach the file the other OS reads.
setting_write() {
	settings_write "$settings_file" "$@"
}

# ------------------------------------------------------------------- content

declare -A labels=(
	[es]='Español            ·  teclado es'
	[us]='English (US)       ·  keyboard us'
	[gb]='English (UK)       ·  keyboard gb'
	[fr]='Français           ·  clavier fr'
	[de]='Deutsch            ·  Tastatur de'
	[it]='Italiano           ·  tastiera it'
	[pt]='Português          ·  teclado pt'
	[latam]='Español (Latam)    ·  teclado latam'
)
layouts=(es us gb fr de it pt latam)

# One entry per translation table that exists, named in its own language: a
# list of languages written in a language you do not read is a list you cannot
# use. The locale is what the system is told; the two-letter prefix is what
# picks the table.
declare -A locales=([en]=en_US.UTF-8 [es]=es_ES.UTF-8)
languages=()
while IFS= read -r table; do
	name="$(basename -- "$table" .conf)"
	[[ -v locales["$name"] ]] || continue
	languages+=("$name")
done < <(find "$repo/i18n" -name '*.conf' -type f | LC_ALL=C sort)
labels[en]='English'
labels[es]='Español'

themes=(bad-romance)
while IFS= read -r file; do themes+=("$(basename -- "$file" .conf)"); done \
	< <(find "$repo/data/themes" -name '*.conf' -type f | LC_ALL=C sort)
for name in "${themes[@]}"; do
	title="$(sed -nE 's/^# @title: (.*)$/\1/p' \
		"$([[ "$name" == bad-romance ]] && printf '%s' "$repo/data/theme.conf" || printf '%s' "$repo/data/themes/$name.conf")")"
	essence="$(sed -nE 's/^# @essence: (.*)$/\1/p' \
		"$([[ "$name" == bad-romance ]] && printf '%s' "$repo/data/theme.conf" || printf '%s' "$repo/data/themes/$name.conf")")"
	printf -v "labels[$name]" '%-18s ·  %s' "$title" "$essence"
done

# The preview is the point: selecting a theme dresses the WHOLE desktop before
# you commit to it — wallpaper, bar, borders, notifications — so the choice is
# made by looking at the room rather than by reading a name. Everything that
# knows how to do that lives in one script; the wizard only picks the name.
#
# A failure must not stop the wizard -- a compositor that is not up yet is a
# normal state on the first run -- but it must not pass unnoticed either. A
# preview that silently does nothing leaves the room exactly as it was, which
# is indistinguishable from a theme that simply looks like the previous one.
# So the run is kept and the footer says where it is.
theme_preview() {
	local name="$1"
	palette_load "$name" || return 0
	mkdir -p -- "$state_dir"
	if (cd "$repo" && ./scripts/apply-theme.sh --theme "$name") >"$preview_log" 2>&1; then
		preview_note=''
	else
		preview_note="$(t welcome.theme.failed "$name" "$preview_log")"
	fi
	return 0
}

# --------------------------------------------------------------------- steps

# The language is asked first and applied immediately: every screen after this
# one is drawn from the table it selects, so asking later would mean conducting
# most of the tour in a language the reader may not have. Writing
# /etc/locale.conf needs root, so the failure is reported rather than hidden --
# the setting is still saved and the rest of the wizard still switches.
step_language() {
	local chosen
	chosen="$(choose "$(t welcome.language.title)" \
		"$(t welcome.language.subtitle)" \
		"$(t welcome.language.hint)" '' "${languages[@]}")"
	setting_write locale "${locales[$chosen]}"
	setting_write language "$chosen"
	mkdir -p -- "$state_dir"
	if ! (cd "$repo" && ./scripts/apply-system.sh --locale) >"$locale_log" 2>&1; then
		preview_note="$(t welcome.language.failed "$locale_log")"
	fi
	i18n_load "$chosen" "${I18N_DIR:-$repo/i18n}" 2>/dev/null ||
		i18n_load en "${I18N_DIR:-$repo/i18n}"
	# The wizard can change its own language mid-run; the bar, the launcher and
	# the panes cannot. They read LANG once, from the session, and the session
	# reads /etc/locale.conf once, at login. Saying so is the difference
	# between a setting that looks broken and one that is merely not finished.
	if [[ -z "$preview_note" && "${LANG%%[._@]*}" != "$chosen" ]]; then
		preview_note="$(t welcome.language.relogin)"
	fi
	printf '%s' "$chosen"
}

step_layout() {
	local chosen
	chosen="$(choose "$(t welcome.layout.title)" \
		"$(t welcome.layout.subtitle)" \
		"$(t welcome.layout.hint)" '' "${layouts[@]}")"
	setting_write xkb_layout "$chosen"
	setting_write keymap "$chosen"
	(cd "$repo" && ./scripts/render-config.sh --deploy) >/dev/null 2>&1 || true
	hyprctl reload >/dev/null 2>&1 || true
	printf '%s' "$chosen"
}

step_theme() {
	local chosen
	chosen="$(choose "$(t welcome.theme.title)" \
		"$(t welcome.theme.subtitle)" \
		"$(t welcome.theme.hint)" theme_preview "${themes[@]}")"
	printf '%s' "$chosen"
}

# The key marked with the Windows logo is what every guide calls SUPER. Nobody
# looking at their keyboard for the first time knows that, and a tour that opens
# with a name the hardware does not use has already lost the reader.
SUPER="$(t welcome.super)"

tour_total=10
tour_step=0

# stage TITLE — the frame every tour step shares, with its place in the queue.
stage() {
	tour_step=$((tour_step + 1))
	frame "$(t welcome.step "$tour_step" "$tour_total")" "$1"
}

# note TITLE LINE... — a step that only has to be read. Some of what a desktop
# offers is not a keystroke to practise but a place to look, and pretending
# otherwise would mean inventing a gesture to detect.
note() {
	local title="$1"
	shift
	{
		stage "$title"
		fg "${palette[COLOR_FG]}"
		local line
		for line in "$@"; do centre "$line"; done
		footer "$(t welcome.continue)"
		reset
	} >/dev/tty
	IFS= read -rsn1 </dev/tty || true
}

# wait_for TITLE INSTRUCTION TIMEOUT PREDICATE [ARG...] — a step that ends when
# the user actually does the thing. Asking someone to read a keybinding teaches
# nothing; asking them to press it and then noticing that they did is the whole
# difference. The predicate is a function name, never a string to eval.
wait_for() {
	local title="$1" instruction="$2" timeout="$3" key
	shift 3
	local deadline=$((SECONDS + timeout))
	{
		stage "$title"
		fg "${palette[COLOR_FG]}"
		local line
		IFS='|' read -ra line <<<"$instruction"
		local part
		for part in "${line[@]}"; do centre "$part"; done
		footer "$(t welcome.skip)"
	} >/dev/tty
	while ((SECONDS < deadline)); do
		if "$@" >/dev/null 2>&1; then
			{
				fg "${palette[COLOR_OK]}"
				centre '✓'
				reset
			} >/dev/tty
			sleep 1
			return 0
		fi
		IFS= read -rsn1 -t 0.4 key </dev/tty && [[ -z "$key" ]] && return 0
	done
	return 0
}

# hyprctl pretty-prints its JSON, so every reading below flattens it first: a
# pattern written as if `"workspace": {"id": 3}` were one line matches nothing
# at all, silently, and a tour step that can never succeed is worse than no
# tour step — it waits two minutes and then pretends the user skipped it.
clients_flat() { hyprctl clients -j 2>/dev/null | tr -d ' \n'; }

window_count() { clients_flat | grep -o '"class":' | grep -c . || printf '0'; }
more_windows_than() { (($(window_count) > $1)); }
fewer_windows_than() { (($(window_count) < $1)); }
current_workspace() {
	hyprctl activeworkspace -j 2>/dev/null | sed -nE 's/.*"id": ?([0-9]+).*/\1/p' | head -1
}
left_first_workspace() {
	local current
	current="$(current_workspace)"
	[[ -n "$current" && "$current" != 1 ]]
}
# A window carried to another desktop, rather than merely opened there: some
# client reports a workspace that is not the one we are looking at.
window_moved_away() {
	local current
	current="$(current_workspace)"
	[[ -n "$current" ]] || return 1
	clients_flat |
		grep -oE '"workspace":\{"id":-?[0-9]+' |
		sed -E 's/.*://' |
		grep -qvx -e "$current" -e '-.*'
}
# The help pane is rofi, and rofi on Wayland draws a layer-shell surface, not a
# window: it never appears in `hyprctl clients` no matter what is grepped for.
# The process is the thing that exists, so the process is what is asked about.
help_pane_open() { pgrep -x rofi >/dev/null 2>&1; }
help_pane_closed() { ! help_pane_open; }
package_installed() { pacman -Qq "$1" >/dev/null 2>&1; }
package_removed() { ! package_installed "$1"; }
volume_changed() {
	local now
	now="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)" || return 1
	[[ -n "$now" && "$now" != "$1" ]]
}

step_tour() {
	local before volume_before
	before="$(window_count)"

	wait_for "$(t welcome.tour.terminal.title)" \
		"$(t welcome.tour.terminal.body "$SUPER")" \
		120 more_windows_than "$before"

	before="$(window_count)"
	wait_for "$(t welcome.tour.close.title)" \
		"$(t welcome.tour.close.body "$SUPER")" \
		120 fewer_windows_than "$before"

	wait_for "$(t welcome.tour.workspace.title)" \
		"$(t welcome.tour.workspace.body "$SUPER")" \
		120 left_first_workspace

	wait_for "$(t welcome.tour.carry.title)" \
		"$(t welcome.tour.carry.body "$SUPER")" \
		180 window_moved_away

	wait_for "$(t welcome.tour.help.title)" \
		"$(t welcome.tour.help.body)" \
		120 help_pane_open

	wait_for "$(t welcome.tour.escape.title)" \
		"$(t welcome.tour.escape.body)" \
		120 help_pane_closed

	# The one step with no gesture to detect, so its lines are split on the
	# same separator wait_for uses rather than being a separate argument each.
	local bar_lines
	IFS='|' read -ra bar_lines <<<"$(t welcome.tour.bar.body)"
	note "$(t welcome.tour.bar.title)" "${bar_lines[@]}"

	volume_before="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || printf 'none')"
	wait_for "$(t welcome.tour.sound.title)" \
		"$(t welcome.tour.sound.body)" \
		120 volume_changed "$volume_before"

	# The part no desktop tour usually teaches, and the only part that makes
	# this a distribution rather than a wallpaper: the package manager. It is
	# taught in both directions on purpose — installing is easy to try and
	# frightening to undo, so the removal is the step that actually lands.
	wait_for "$(t welcome.tour.install.title)" \
		"$(t welcome.tour.install.body)" \
		1200 package_installed chromium

	wait_for "$(t welcome.tour.remove.title)" \
		"$(t welcome.tour.remove.body)" \
		600 package_removed chromium

	{
		frame "$(t welcome.done.title)" "$(t welcome.done.subtitle)"
		fg "${palette[COLOR_FG]}"
		centre "$(t welcome.done.help)"
		centre "$(t welcome.done.keys "$SUPER")"
		centre "$(t welcome.done.power "$SUPER")"
		centre ''
		fg "${palette[COLOR_FG_DIM]}"
		centre "$(t welcome.done.rerun)"
		centre "$(t welcome.done.theme)"
		footer "$(t welcome.done.hint)"
		reset
	} >/dev/tty
	IFS= read -rsn1 </dev/tty || true
}

# ----------------------------------------------------------------------- run

palette_load "$(sed -nE 's/^theme=(.*)$/\1/p' "$settings_file" 2>/dev/null | tail -1)" ||
	palette_load bad-romance

printf '\033[?25l'
restore() {
	printf '\033[?25h'
	reset
	printf '\033[2J\033[H'
}
trap restore EXIT

{
	frame "$(t welcome.intro.title)" "$(t welcome.intro.subtitle)"
	fg "${palette[COLOR_FG]}"
	centre "$(t welcome.intro.body)"
	footer "$(t welcome.intro.hint)"
	reset
} >/dev/tty
IFS= read -rsn1 </dev/tty || true

step_language >/dev/null
step_layout >/dev/null
step_theme >/dev/null
step_tour

mkdir -p -- "$state_dir"
printf 'welcome completed: %s\n' "$(date -uIseconds)" >"$marker"
