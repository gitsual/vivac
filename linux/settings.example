# Example user settings, for documentation.
#
# The real file lives in $XDG_CONFIG_HOME/vivac/settings and is
# never committed. These are choices, not detections: hardware facts describe
# what the machine is, settings describe what its owner wants. A missing file
# means these defaults, which reproduce the source workstation.
#
# Each axis has exactly one writer:
#   locale      scripts/apply-system.sh --locale   -> /etc/locale.conf, /etc/locale.gen
#   keymap      scripts/apply-system.sh --keymap   -> /etc/vconsole.conf
#   xkb_layout  scripts/render-config.sh --deploy  -> ~/.config/hypr/generated/input.lua
#   ime         scripts/render-config.sh --deploy  -> ~/.config/hypr/generated/input.lua
#               (none or fcitx5; the packages come from bootstrap.sh --ime)
#   theme       scripts/render-config.sh --deploy  -> every themed config
#               (a name from data/themes/, or bad-romance for the default)
#   weather_location
#               scripts/render-config.sh --deploy  -> the bar's weather module
#               (auto lets wttr.in geolocate by IP; a place name or airport
#               code asks about somewhere else)
#   language    the language of the bar, the panes and the tour: auto follows LANG,
#               or a table name from i18n/ (en, es). Shared.
#   shared_settings
#               none, or the path of a flat KV file another OS also reads
#               (absolute, or under ~/). Only theme, weather_location and
#               language travel through it; a missing folder disables sharing.
#   localsend_pin
#               the PIN a phone must give to send here with LocalSend
#               (vivac-localsend, docs/bridge.md): auto keeps the six random
#               digits made when it is first turned on, or 4 to 32 letters and
#               digits of your own. Never shared.
locale=es_ES.UTF-8
keymap=es
xkb_layout=es
ime=none
theme=bad-romance
weather_location=auto
language=auto
shared_settings=none
localsend_pin=auto
