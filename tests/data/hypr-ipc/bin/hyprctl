#!/usr/bin/env bash
# Fixture hyprctl for the IPC helper tests. Every call is recorded: one %q line
# per call in $HYPR_STUB_DIR/calls, and the arguments (space-joined) of the last `dispatch`
# in $HYPR_STUB_DIR/last_dispatch. `eval 'return true'` is the Lua-mode probe:
# it answers ok when HYPR_STUB_LUA=1 and fails the way a hyprlang session does
# otherwise.
set -Eeuo pipefail
dir="${HYPR_STUB_DIR:?}"
printf '%q ' "$@" >>"$dir/calls"
printf '\n' >>"$dir/calls"
case "${1:-}" in
eval)
	if [[ "${HYPR_STUB_LUA:-0}" == 1 ]]; then
		printf 'ok\n'
	else
		printf 'unknown request\n'
		exit 1
	fi
	;;
dispatch)
	printf '%s' "${*:2}" >"$dir/last_dispatch"
	printf 'ok\n'
	;;
*) exit 2 ;;
esac
