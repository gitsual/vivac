#!/usr/bin/env bash
# A terminal on the vivac computer, once paired (vivac-pair). Arguments, if
# any, are the command to run there:  vivac-pc claude --continue
set -Eeuo pipefail
[[ "$(vivac-pair status 2>/dev/null)" != none ]] || vivac-pair >/dev/null
if (($#)); then
	tty=-T
	[[ -t 0 ]] && tty=-t
	exec ssh "$tty" pc "$(printf '%q ' "$@")"
fi
exec ssh -t pc
