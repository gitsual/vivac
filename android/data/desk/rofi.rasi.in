/* The phone's own desktop launcher (android/bin/vivac-desk), the computer's
   rofi theme at the phone's scale. */
configuration {
    dpi: 192;
    font: "JetBrainsMono Nerd Font 11";
    show-icons: false;
    drun-display-format: "{name}";
    display-drun: "󰀻";
    display-run: "";
    display-dmenu: "⏻";
}
* {
    bg0: #@COLOR_BG@f2;
    bg1: #@COLOR_SURFACE:lower@;
    fg0: #@COLOR_FG@;
    fg2: #@COLOR_FG_DIM:lower@;
    accent: #@COLOR_ACCENT@;
    urgent: #@COLOR_URGENT@;
    transparent: #00000000;
    background-color: @transparent;
    text-color: @fg0;
    font: "JetBrainsMono Nerd Font 11";
}
window { location: center; anchor: center; width: 88%; background-color: @bg0; border: 6px; border-color: @accent; border-radius: 24px; }
mainbox { spacing: 28px; padding: 32px; }
inputbar { background-color: @bg1; border: 0 0 4px 0; border-color: @accent; border-radius: 16px; padding: 20px; spacing: 16px; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry { placeholder: "Search"; placeholder-color: @fg2; }
listview { columns: 1; lines: 9; spacing: 12px; }
element { border-radius: 16px; padding: 18px 24px; spacing: 16px; }
element normal.normal, element alternate.normal { background-color: @bg1; text-color: @fg0; }
element selected.normal { background-color: @accent; text-color: @bg0; }
element normal.urgent { background-color: @urgent; text-color: @bg0; }
element-text { text-color: inherit; background-color: transparent; }
