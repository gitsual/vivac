# The phone's own desktop compositor (android/bin/vivac-desk): rounded
# windows, soft shadows and fades, as Hyprland draws them on the computer.
# xrender: Termux:X11 has no GL to give picom.
backend = "xrender";
vsync = false;
corner-radius = 24;
rounded-corners-exclude = [ "class_g = 'Polybar'", "class_g = 'Rofi'" ];
shadow = true;
shadow-radius = 28;
shadow-opacity = 0.45;
shadow-offset-x = -20;
shadow-offset-y = -14;
shadow-exclude = [ "class_g = 'Polybar'" ];
fading = true;
fade-in-step = 0.06;
fade-out-step = 0.06;
inactive-opacity = 0.94;
active-opacity = 1.0;
opacity-rule = [ "100:class_g = 'Rofi'", "100:class_g = 'Polybar'" ];
