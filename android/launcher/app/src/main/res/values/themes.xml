<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Noche 900 behind everything, so there is no white flash before Compose draws. -->
    <style name="Theme.Vivac" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/noche_900</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
