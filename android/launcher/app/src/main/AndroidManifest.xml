<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Swipe down on the Campamento pulls the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- "Desinstalar" opens the system confirmation; Android requires this to send ACTION_DELETE. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 15: the home app may show the private space (normal permission, granted at install). -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <!-- A launcher must see every launchable app; Android 11+ hides them otherwise. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vivac">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Another app's "Add to home screen" (shortcuts and widgets); Android sends it only to the default home app. -->
        <activity
            android:name=".PinActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Vivac.Pin">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>

        <!-- Double tap to lock (opt-in from the camp menu): the only way Android lets an app turn the screen off. -->
        <service
            android:name=".apps.LockService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/lock_service" />
        </service>

        <!-- Notification dots: reads only which app each notification belongs to. Off until you allow it. -->
        <service
            android:name=".apps.DotsListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
