#!/usr/bin/env bash
# Build vivac-os for one GrapheneOS release tag, up to the unsigned release
# inputs (releases/BUILD/*-target_files.zip and *-otatools.zip).
# Usage: vivac-os-build TAG      (env VIVAC_OS_ROOT, VIVAC_OS_DEVICE, VIVAC_OS_BUILD_NUMBER)
# Steps: vivac-os-sync (shallow, signature-checked), apply the vivac patches,
# regenerate vendor files, build, finalize.
set -Eeuo pipefail

(($# == 1)) && [[ "$1" =~ ^[0-9]{10}$ ]] || { printf 'usage: %s TAG(10 digits)\n' "${0##*/}" >&2; exit 2; }
tag="$1"
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
root="${VIVAC_OS_ROOT:-$HOME/m2/vivac-os}"
device="${VIVAC_OS_DEVICE:-shiba}"
tree="$root/src" # not "src": envsetup.sh reuses that name in a loop

VIVAC_OS_ROOT="$root" "$here/vivac-os-sync" "$tag"
cd "$tree"

"$here/vivac-os-customize" "$tree" "$here/../patches"

yarn --cwd vendor/adevtool/ install
set +u # envsetup.sh and lunch are not written for nounset
# shellcheck disable=SC1091
source build/envsetup.sh
# envsetup.sh defines adevtool as an alias, which a script never expands.
vendor/adevtool/bin/run generate-all -d "$device"
lunch "$device-cur-user"
set -u
export BUILD_NUMBER="${VIVAC_OS_BUILD_NUMBER:-$tag}"
# OFFICIAL_BUILD turns the Updater on; only safe once our patch points it at our server.
if grep -rqs 'name="url"' "$here/../patches/packages/apps/Updater"; then export OFFICIAL_BUILD=true; fi

rm -rf out
m vendorbootimage vendorkernelbootimage target-files-package
m otatools-package
script/finalize.sh
printf 'vivac-os build %s ready in %s/releases/%s\n' "$BUILD_NUMBER" "$tree" "$BUILD_NUMBER"
