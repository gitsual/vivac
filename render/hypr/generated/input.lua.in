-- Generated by scripts/render-config.sh from this machine's hardware facts.
-- Do not edit: correct the facts in the override file and re-render.
hl.config({ input = { kb_layout = "@SETTING_XKB_LAYOUT@", follow_mouse = 1 } })
@?has_touchpad=yes@ hl.config({ input = { touchpad = { natural_scroll = true, tap_to_click = true } } })
-- Input method (settings: ime). fcitx5 on Wayland: the environment tells Qt
-- and X11 clients to use it, GTK clients use the text-input protocol on
-- their own, and the daemon starts with the session through vivac.autostart.
-- Nothing else changes.
@?setting_ime=fcitx5@ hl.env("QT_IM_MODULE", "fcitx")
@?setting_ime=fcitx5@ hl.env("XMODIFIERS", "@im=fcitx")
@?setting_ime=fcitx5@ hl.env("SDL_IM_MODULE", "fcitx")
@?setting_ime=fcitx5@ table.insert(vivac.autostart, { id = "fcitx5", cmd = "fcitx5 -d" })
