-- Generated by scripts/render-config.sh from this machine's hardware facts.
-- Do not edit: correct the facts in the override file and re-render.
--
-- The NVIDIA environment applies only when NVIDIA is the sole GPU. On a hybrid
-- laptop the integrated GPU drives the displays and these variables would
-- point Wayland at the wrong device: there, NVIDIA is used per application
-- through PRIME offload (prime-run), and the compositor is left alone.
@?gpu_vendors~nvidia && gpu_hybrid=no@ hl.env("LIBVA_DRIVER_NAME", "nvidia")
@?gpu_vendors~nvidia && gpu_hybrid=no@ hl.env("GBM_BACKEND", "nvidia-drm")
@?gpu_vendors~nvidia && gpu_hybrid=no@ hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
@?gpu_vendors~nvidia && gpu_hybrid=no@ hl.env("NVIDIA_FORCE_PROBE", "1")
@?gpu_vendors~nvidia && gpu_hybrid=no || virt!=none@ hl.config({ cursor = { no_hardware_cursors = true } })
@?gpu_hybrid=yes && gpu_vendors~nvidia@-- Hybrid graphics: the integrated GPU drives the displays. Run a program on
@?gpu_hybrid=yes && gpu_vendors~nvidia@-- the NVIDIA GPU with prime-run (package nvidia-prime).
