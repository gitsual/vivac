{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 15,
  "margin-right": 15,
  "modules-left": ["group/workspaces", "hyprland/submap", "hyprland/window", "custom/updates"],
  "modules-center": ["clock", "custom/weather"],
  "modules-right": [
@?has_wifi=yes@    "network#wireless",
    "network#wired",
@?has_bluetooth=yes@    "bluetooth",
    "cpu",
    "memory",
    "disk",
@?cpu_temp_path!=none@    "temperature",
@?gpu_vendors~nvidia@    "custom/gpu",
@?has_backlight=yes@    "backlight",
@?has_battery=yes@    "battery",
    "pulseaudio",
    "custom/theme",
    "custom/power"
  ],
  "group/workspaces": {"orientation": "horizontal", "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"]},
  "custom/ws1": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 1", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 1", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws2": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 2", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 2", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws3": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 3", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 3", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws4": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 4", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 4", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws5": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 5", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 5", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws6": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 6", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 6", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws7": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 7", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 7", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws8": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 8", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 8", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws9": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 9", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 9", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "custom/ws10": {"exec": "$HOME/.config/waybar/scripts/ws-render.sh 10", "return-type": "json", "signal": 1, "format": "{}", "on-click": "$HOME/.config/hypr/scripts/dispatch.sh workspace 10", "on-scroll-up": "$HOME/.config/hypr/scripts/dispatch.sh workspace e-1", "on-scroll-down": "$HOME/.config/hypr/scripts/dispatch.sh workspace e+1"},
  "hyprland/window": {"format": "{title}", "max-length": 60, "separate-outputs": true, "rewrite": {"": "󰇄 desktop"}},
  "hyprland/submap": {"format": "󰌌 {}", "tooltip": false},
  "clock": {"format": "󰥔 {:%H:%M  %a %d %b %Y}", "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"},
  "cpu": {"format": "󰻠 {usage}%", "interval": 2},
  "memory": {"format": "󰍛 {percentage}%", "interval": 5},
  "disk": {"format": "󰋊 {percentage_used}%", "path": "/", "interval": 30},
@?has_wifi=yes@  "network#wireless": {"interface": "wl*", "format-wifi": "  {essid} {signalStrength}%", "format-linked": " {essid} (no IP)", "format-disconnected": "󰖪 Wi-Fi", "format-disabled": "󰖪 Wi-Fi off", "format-alt": " {ifname}: {ipaddr}/{cidr}", "tooltip-format-wifi": "{essid} {signalStrength}%  {frequency} GHz\n{ifname}  {ipaddr}/{cidr}  gw {gwaddr}\nUp: {bandwidthUpBits}  Down: {bandwidthDownBits}", "tooltip-format-disconnected": "Wi-Fi: not connected", "on-click": "$HOME/.config/waybar/scripts/net-wireless.sh", "on-click-right": "nm-connection-editor", "on-click-middle": "$HOME/.config/waybar/scripts/net-wireless.sh", "interval": 5},
  "network#wired": {"interface": "e*", "format-ethernet": "󰈀 {ipaddr}/{cidr}", "format-linked": "󰈀 {ifname} (no IP)", "format-disconnected": "󰈂 wired", "format-alt": "󰈀 {ifname}: {ipaddr}/{cidr}", "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}  gw {gwaddr}\nUp: {bandwidthUpBits}  Down: {bandwidthDownBits}", "tooltip-format-disconnected": "Wired: no link", "on-click": "$HOME/.config/waybar/scripts/net-wired.sh", "on-click-right": "nm-connection-editor", "on-click-middle": "$HOME/.config/waybar/scripts/net-wired.sh", "interval": 5},
@?has_bluetooth=yes@  "bluetooth": {"format": "{icon}", "format-icons": {"enabled": "󰂯", "disabled": "󰂲", "connected": "󰂱"}, "format-connected": "{icon} {num_connections}", "tooltip-format": "{status}", "tooltip-format-connected": "{device_enumerate}", "tooltip-format-enumerate-connected": "{device_alias}", "on-click": "blueman-manager"},
@?cpu_temp_path!=none@  "temperature": {"hwmon-path": "@FACT_CPU_TEMP_PATH@", "critical-threshold": 80, "format": "{icon} {temperatureC}°C", "format-icons": ["", "", ""], "tooltip-format": "CPU: {temperatureC}°C"},
@?gpu_vendors~nvidia@  "custom/gpu": {"exec-if": "command -v nvidia-smi", "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits", "format": "󰢮 {}°C", "interval": 5},
@?has_backlight=yes@  "backlight": {"format": "{icon} {percent}%", "format-icons": ["󰃞", "󰃟", "󰃠"], "on-scroll-up": "brightnessctl set +5%", "on-scroll-down": "brightnessctl set 5%-"},
@?has_battery=yes@  "battery": {"format": "{icon} {capacity}%", "format-charging": "󰂄 {capacity}%", "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"], "states": {"warning": 30, "critical": 15}, "interval": 30},
  "pulseaudio": {"format": "{icon} {volume}%", "format-muted": "󰝟", "format-icons": {"default": ["", "", ""]}, "on-click": "pavucontrol"},
@?setting_weather_location=auto@  "custom/weather": {"exec": "curl -sf -m 5 'wttr.in/?format=1'", "interval": 1800, "format": "{}", "tooltip": false},
@?setting_weather_location!=auto@  "custom/weather": {"exec": "curl -sf -m 5 'wttr.in/@SETTING_WEATHER_LOCATION@?format=1'", "interval": 1800, "format": "{}", "tooltip": false},
  "custom/updates": {"exec": "checkupdates | wc -l", "format": "󰏔 {}", "interval": 3600, "on-click": "kitty -e sudo pacman -Syu"},
  "custom/theme": {"format": "◐", "on-click": "$HOME/.local/bin/vivac-theme", "tooltip": false},
  "custom/power": {"format": "⏻", "on-click": "$HOME/.config/rofi/power/powermenu.sh", "tooltip": false}
}
